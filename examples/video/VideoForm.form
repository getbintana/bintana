{
  "format": "bintana-form/1",
  "class": "VideoForm",
  "properties": {
    "Height": 420,
    "Text": "Video player",
    "Width": 630
  },
  "children": [
    {
      "type": "Video",
      "name": "Vid",
      "properties": {
        "Fit": "Contain",
        "Height": 300,
        "Width": 400,
        "X": 12,
        "Y": 12
      }
    },
    {
      "type": "Label",
      "name": "LblClip",
      "properties": {
        "Height": 24,
        "Text": "Clip:",
        "Width": 190,
        "X": 428,
        "Y": 12
      }
    },
    {
      "type": "ComboBox",
      "name": "CmbClips",
      "properties": {
        "Height": 34,
        "Width": 190,
        "X": 428,
        "Y": 38
      }
    },
    {
      "type": "Button",
      "name": "BtnPlay",
      "properties": {
        "Height": 34,
        "Text": "Play",
        "Width": 90,
        "X": 428,
        "Y": 86
      }
    },
    {
      "type": "Button",
      "name": "BtnPause",
      "properties": {
        "Height": 34,
        "Text": "Pause",
        "Width": 92,
        "X": 526,
        "Y": 86
      }
    },
    {
      "type": "Button",
      "name": "BtnStop",
      "properties": {
        "Height": 34,
        "Text": "Stop",
        "Width": 190,
        "X": 428,
        "Y": 128
      }
    },
    {
      "type": "CheckButton",
      "name": "ChkLoop",
      "properties": {
        "Height": 28,
        "Text": "Loop",
        "Width": 190,
        "X": 428,
        "Y": 172
      }
    },
    {
      "type": "CheckButton",
      "name": "ChkMuted",
      "properties": {
        "Height": 28,
        "Text": "Muted",
        "Width": 190,
        "X": 428,
        "Y": 200
      }
    },
    {
      "type": "Label",
      "name": "LblVol",
      "properties": {
        "Height": 24,
        "Text": "Volume",
        "Width": 190,
        "X": 428,
        "Y": 234
      }
    },
    {
      "type": "Slider",
      "name": "SldVol",
      "properties": {
        "Height": 36,
        "Max": 100,
        "Min": 0,
        "Value": 100,
        "Width": 190,
        "X": 428,
        "Y": 258
      }
    },
    {
      "type": "Button",
      "name": "BtnAudio",
      "properties": {
        "Height": 34,
        "Text": "Play audio cue",
        "Width": 190,
        "X": 428,
        "Y": 308
      }
    },
    {
      "type": "Label",
      "name": "LblPos",
      "properties": {
        "Height": 24,
        "Text": "0.0 / --",
        "Width": 200,
        "X": 12,
        "Y": 320
      }
    },
    {
      "type": "ProgressBar",
      "name": "PrgBuf",
      "properties": {
        "Height": 24,
        "ShowText": true,
        "Visible": false,
        "Width": 200,
        "X": 212,
        "Y": 320
      }
    },
    {
      "type": "Label",
      "name": "LblStatus",
      "properties": {
        "Height": 60,
        "Width": 606,
        "Wrap": true,
        "X": 12,
        "Y": 348
      }
    }
  ]
}