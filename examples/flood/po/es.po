# Spanish for the flood example.
#
# Nothing in project.json points at this directory: po/ is found by name, the way
# icons/ and app.css are.  The runtime reads the .po itself rather than a compiled
# .mo, because nothing in a project directory is generated.
#
# The template (flood.pot) is written by the IDE: Project > Update translations,
# which walks the .form files and the code; `msgmerge --update` is what brings
# this file to it after a new string appears.
msgid ""
msgstr ""
"Project-Id-Version: flood\n"
"Language: es\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

