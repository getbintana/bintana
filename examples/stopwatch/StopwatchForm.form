        "Width": 356,
        "X": 12,
        "Y": 24
      }
    },
    {
      "type": "Button",
      "name": "BtnStart",
      "properties": {
        "Focusable": false,
        "Height": 40,
        "Shortcut": ["space"],
        "Style": "suggested-action",
        "Text": "Start",
        "Tooltip": "Space",
        "Width": 110,
        "X": 12,
        "Y": 96
      }
    },
    {
      "type": "Button",
      "name": "BtnLap",
      "properties": {
        "Enabled": false,
