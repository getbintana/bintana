{
  "format": "bintana-form/1",
  "class": "UptimeSettings",
  "properties": {
    "Width": 243,
    "Height": 116,
    "Arrangement": "Vertical",
    "Spacing": 8,
    "Padding": 6
  },
  "children": [
    {
      "type": "Grid",
      "name": "Grid1",
      "properties": {
        "ColumnSpacing": 6,
        "Columns": 3,
        "Height": 74,
        "RowSpacing": 6,
        "Spacing": 6,
        "Width": 243
      },
      "children": [
        {
          "type": "Label",
          "name": "LblEvery",
          "properties": {
            "Text": "Every",
            "VAlign": "Center",
            "Width": 80
          }
        },
        {
          "type": "SpinBox",
          "name": "SpinInterval",
          "properties": {
            "HExpand": true,
            "Max": 3600,
            "Min": 1,
            "Value": 30,
            "Width": 130
          }
        },
        {
          "type": "Label",
          "name": "LblSeconds",
          "properties": {
            "Text": "s",
            "VAlign": "Center"
          }
        },
        {
          "type": "Label",
          "name": "LblTimeout",
          "properties": {
            "Text": "Timeout",
            "VAlign": "Center",
            "Width": 80
          }
        },
        {
          "type": "SpinBox",
          "name": "SpinTimeout",
          "properties": {
            "HExpand": true,
            "Max": 60000,
            "Min": 100,
            "Step": 100,
            "Value": 5000,
            "Width": 130
          }
        },
        {
          "type": "Label",
          "name": "LblMillis",
          "properties": {
            "Text": "ms",
            "VAlign": "Center"
          }
        }
      ]
    },
    {
      "type": "Button",
      "name": "BtnSave",
      "properties": {
        "Height": 24,
        "Icon": "document-save-symbolic",
        "Text": "Save",
        "Width": 231
      }
    }
  ]
}
