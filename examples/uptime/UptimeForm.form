{
  "format": "bintana-form/1",
  "class": "UptimeForm",
  "properties": {
    "Text": "Uptime",
    "Width": 644,
    "Height": 452,
    "Arrangement": "Vertical",
    "Spacing": 8,
    "Padding": 12
  },
  "components": [
    {
      "type": "Timer",
      "name": "Clock",
      "properties": {
        "Delay": 30000,
        "Enabled": true
      }
    },
    {
      "type": "Connection",
      "name": "Db",
      "properties": {
        "Path": "uptime.db"
      }
    },
    {
      "type": "Model",
      "name": "Checks",
      "properties": {
        "Connection": "Db",
        "Record": "Check",
        "TableName": "checks"
      }
    },
    {
      "type": "Model",
      "name": "Sites",
      "properties": {
        "Connection": "Db",
        "Record": "Site",
        "TableName": "sites"
      }
    },
    {
      "type": "Model",
      "name": "Config",
      "properties": {
        "Connection": "Db",
        "Record": "Config",
        "TableName": "config"
      }
    },
    {
      "type": "HttpClient",
      "name": "Api",
      "properties": {
        "Timeout": 5000,
        "Http1": true
      }
    }
  ],
  "children": [
    {
      "type": "Panel",
      "name": "Bar",
      "properties": {
        "Arrangement": "Horizontal",
        "HAlign": "Fill",
        "Spacing": 8
      },
      "children": [
        {
          "type": "Label",
          "name": "LblStatus",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Text": "every 30 s — no check yet",
            "VAlign": "Center"
          }
        },
        {
          "type": "Panel",
          "name": "BtnBox",
          "properties": {
            "Arrangement": "Horizontal",
            "Anchored": false,
            "Style": "linked"
          },
          "children": [
            {
              "type": "Button",
              "name": "BtnCheck",
              "properties": {
                "Icon": "view-refresh-symbolic",
                "Text": "Check now"
              }
            },
            {
              "type": "Button",
              "name": "BtnSettings",
              "properties": {
                "Icon": "emblem-system-symbolic"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "TableView",
      "name": "History",
      "properties": {
        "Columns": [
          {
            "Text": "Site",
            "Width": 120
          },
          {
            "Text": "Status",
            "Width": 80,
            "Alignment": "Right"
          },
          {
            "Text": "ms",
            "Width": 70,
            "Alignment": "Right"
          },
          {
            "Text": "At",
            "Width": 100
          },
          {
            "Text": "Error",
            "Width": 0
          }
        ],
        "HAlign": "Fill",
        "MinHeight": 220,
        "Style": "frame",
        "VExpand": true
      }
    },
    {
      "type": "Label",
      "name": "LblHint",
      "properties": {
        "Style": "dim-label",
        "Text": "One row per request in uptime.db; a failure is a row too."
      }
    }
  ]
}
