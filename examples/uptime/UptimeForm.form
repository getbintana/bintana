{
  "format": "bintana-form/1",
  "class": "UptimeForm",
  "properties": {
    "Text": "Uptime",
    "Width": 680,
    "Height": 460,
    "Arrangement": "Vertical",
    "Spacing": 8,
    "Padding": 12
  },
  "components": [
    {
      "type": "Timer",
      "name": "Clock",
      "properties": {
        "Delay": 30000,
        "Enabled": true
      }
    },
    {
      "type": "Connection",
      "name": "Db",
      "properties": {
        "Path": "uptime.db"
      }
    },
    {
      "type": "Model",
      "name": "Checks",
      "properties": {
        "Connection": "Db",
        "Record": "Check",
        "TableName": "checks"
      }
    },
    {
      "type": "Model",
      "name": "Sites",
      "properties": {
        "Connection": "Db",
        "Record": "Site",
        "TableName": "sites"
      }
    },
    {
      "type": "Model",
      "name": "Config",
      "properties": {
        "Connection": "Db",
        "Record": "Config",
        "TableName": "config"
      }
    },
    {
      "type": "HttpClient",
      "name": "Api",
      "properties": {
        "Timeout": 5000,
        "Http1": true
      }
    }
  ],
  "children": [
    {
      "type": "Panel",
      "name": "Bar",
      "properties": {
        "Arrangement": "Horizontal",
        "Spacing": 8,
        "HAlign": "Fill"
      },
      "children": [
        {
          "type": "Label",
          "name": "LblStatus",
          "properties": {
            "Text": "every 30 s — no check yet",
            "HAlign": "Fill",
            "HExpand": true,
            "VAlign": "Center"
          }
        },
        {
          "type": "Button",
          "name": "BtnCheck",
          "properties": {
            "Text": "Check now",
            "Icon": "view-refresh-symbolic",
            "Width": 130
          }
        }
      ]
    },
    {
      "type": "Panel",
      "name": "Settings",
      "properties": {
        "Arrangement": "Horizontal",
        "Spacing": 8,
        "HAlign": "Fill"
      },
      "children": [
        {
          "type": "Label",
          "name": "LblEvery",
          "properties": { "Text": "Every", "VAlign": "Center" }
        },
        {
          "type": "SpinBox",
          "name": "SpinInterval",
          "properties": { "Min": 1, "Max": 3600, "Step": 1, "Value": 30, "Width": 90 }
        },
        {
          "type": "Label",
          "name": "LblSeconds",
          "properties": { "Text": "s", "VAlign": "Center" }
        },
        {
          "type": "Label",
          "name": "LblTimeout",
          "properties": { "Text": "Timeout", "VAlign": "Center" }
        },
        {
          "type": "SpinBox",
          "name": "SpinTimeout",
          "properties": { "Min": 100, "Max": 60000, "Step": 100, "Value": 5000, "Width": 110 }
        },
        {
          "type": "Label",
          "name": "LblMillis",
          "properties": { "Text": "ms", "VAlign": "Center" }
        },
        {
          "type": "Button",
          "name": "BtnSaveConfig",
          "properties": { "Text": "Save", "Icon": "document-save-symbolic", "Width": 100 }
        },
        {
          "type": "Label",
          "name": "LblSites",
          "properties": { "Text": "", "Style": "dim-label", "HExpand": true, "VAlign": "Center" }
        }
      ]
    },
    {
      "type": "TableView",
      "name": "History",
      "properties": {
        "Columns": [
          { "Text": "Site",   "Width": 120 },
          { "Text": "Status", "Width": 80, "Alignment": "Right" },
          { "Text": "ms",     "Width": 70, "Alignment": "Right" },
          { "Text": "At",     "Width": 100 },
          { "Text": "Error",  "Width": 0 }
        ],
        "HAlign": "Fill",
        "VExpand": true,
        "MinHeight": 220
      }
    },
    {
      "type": "Label",
      "name": "LblHint",
      "properties": {
        "Text": "One row per request in uptime.db; a failure is a row too.",
        "Style": "dim-label"
      }
    }
  ]
}
