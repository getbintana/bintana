{
  "format": "bintana-form/1",
  "class": "ReportForm",
  "properties": {
    "Text": "Statement of account",
    "Width": 940,
    "Height": 720,
    "Arrangement": "Vertical",
    "Spacing": 8,
    "Margin": 12
  },
  "children": [
    {
      "type": "Panel",
      "name": "Body",
      "properties": {
        "Arrangement": "Horizontal",
        "Spacing": 8,
        "Expand": true
      },
      "children": [
        {
          "type": "Frame",
