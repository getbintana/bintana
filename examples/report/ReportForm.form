              "properties": {
                "Expand": true,
                "Margin": 8,
                "Paper": "A4",
                "Orientation": "Portrait",
                "Margins": 40,
                "Sections": {
                  "ReportHeader": {
                    "Height": 64,
                    "Elements": [
                      {
                        "Kind": "Image",
                        "File": "logo.png",
                        "X": 0,
                        "Y": 0,
                        "Height": 44
                      },
                      {
                        "Kind": "Text",
                        "Text": "Statement of account",
                        "X": 56,
                        "Y": 2,
                        "Font": "Bold 18"
                      },
                      {
                        "Kind": "Text",
                        "Text": "@Today",
                        "X": 56,
                        "Y": 28
                      },
                      {
                        "Kind": "Line",
                        "X1": 0,
                        "Y1": 58,
                        "X2": 515,
                        "Y2": 58
                      }
                    ]
                  },
                  "PageHeader": {
                    "Height": 24,
