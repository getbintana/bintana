                            "Width": 115,
                            "Align": "Right",
                            "Font": "Bold 10"
                          },
                          {
                            "Kind": "Total",
                            "Field": "Amount",
                            "Op": "Sum",
                            "Format": "Money",
                            "X": 430,
                            "Y": 10,
                            "Width": 85,
                            "Align": "Right",
                            "Font": "Bold 10"
                          },
                          {
                            "Kind": "Total",
                            "Field": "What",
                            "Op": "Count",
                            "X": 8,
                            "Y": 10
                          },
                          {
                            "Kind": "Text",
                            "Text": "orders",
                            "X": 48,
                            "Y": 10
                          }
                        ]
                      }
                    },
                    {
                      "On": "Client",
