                      {
                        "Kind": "Line",
                        "X1": 0,
                        "Y1": 2,
                        "X2": 515,
                        "Y2": 2
                      },
                      {
                        "Kind": "Text",
                        "Text": "Page",
                        "X": 0,
                        "Y": 8
                      },
                      {
                        "Kind": "Field",
                        "Field": "@Page",
                        "X": 42,
                        "Y": 8
                      },
                      {
                        "Kind": "Text",
                        "Text": "of",
                        "X": 58,
                        "Y": 8
                      },
                      {
                        "Kind": "Field",
                        "Field": "@Pages",
                        "X": 76,
                        "Y": 8
