            },
            {
              "type": "Button",
              "name": "BtnPdf",
              "properties": {
                "Text": "Export PDF"
              }
            },
            {
              "type": "Button",
              "name": "BtnPrint",
              "properties": {
                "Text": "Print..."
              }
            },
            {
              "type": "Label",
              "name": "LblStatus",
              "properties": {
                "Text": "",
                "Style": "dim-label",
                "Wrap": true,
                "Alignment": "Left",
                "Expand": true
              }
            }
          ]
        }
