{
  "format": "bta-record/1",
  "class": "Invoice",
  "naming": "snake",
  "fields": {
    "Id":         { "kind": "int", "key": true },
    "CustomerId": { "kind": "int", "required": true },
    "Day":        { "kind": "date", "required": true },
    "Total":      { "kind": "decimal", "decimals": 2 }
  }
}
