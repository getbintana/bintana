{
  "format": "bintana-form/1",
  "class": "Calculator",
  "properties": {
    "Text": "Calculadora",
    "Icon": "accessories-calculator",
    "Arrangement": "Vertical",
    "Spacing": 8,
    "Padding": 12,
    "Width": 300,
    "Height": 400,
    "MinWidth": 240,
    "MinHeight": 320
  },
  "children": [
    {
      "type": "Label",
      "name": "Display",
      "properties": {
        "Alignment": "Right",
        "Ellipsize": true,
        "Font": "Normal 20",
        "HAlign": "Fill",
        "HExpand": true,
        "Height": 37,
        "MinHeight": 52,
        "Style": "bta-display",
        "Text": "0",
        "Width": 300
      }
    },
    {
      "type": "Grid",
      "name": "Keys",
      "properties": {
        "ColumnSpacing": 6,
        "Columns": 4,
        "Expand": true,
        "HAlign": "Fill",
        "HExpand": true,
        "Height": 363,
        "Homogeneous": true,
        "RowSpacing": 6,
        "Spacing": 6,
        "VAlign": "Fill",
        "VExpand": true,
        "Width": 300
      },
      "children": [
        {
          "type": "Button",
          "name": "BtnClear",
          "properties": {
            "Expand": true,
            "Focusable": false,
            "HAlign": "Fill",
            "HExpand": true,
            "Shortcut": [
              "Escape",
              "Delete"
            ],
            "Style": "destructive-action",
            "Text": "C",
            "VAlign": "Fill",
            "VExpand": true
          }
        },
        {
          "type": "Button",
          "name": "BtnBack",
          "properties": {
            "Expand": true,
            "Focusable": false,
            "HAlign": "Fill",
