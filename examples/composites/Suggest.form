{
  "format": "bintana-form/1",
  "class": "Suggest",
  "properties": {
    "Height": 40,
    "Width": 360
  },
  "children": [
    {
      "type": "TextBox",
      "name": "Txt",
      "properties": {
        "HAlign": "Fill",
        "Height": 40,
        "Placeholder": "Type…",
        "Width": 360,
        "X": 0,
        "Y": 0
      }
    },
    {
      "type": "Popover",
      "name": "Pop",
      "properties": {
        "Autohide": false
      },
      "children": [
        {
          "type": "RowList",
          "name": "Lst",
          "properties": {
            "ActivateOnSingleClick": true,
            "Height": 200,
            "Width": 360
          }
        }
      ]
    }
  ]
}
