        "Y": 8,
        "Width": 140,
        "Height": 30,
        "Value": 3
      }
    },
    {
      "type": "Panel",
      "name": "Bar",
      "properties": {
        "Arrangement": "Horizontal",
        "Margin": 4,
        "Spacing": 8
      },
      "children": [
        {
          "type": "Button",
          "name": "B1",
          "properties": {
            "Text": "one"
          }
        },
        {
          "type": "Label",
          "name": "L1",
          "properties": {
            "Text": "two",
            "HExpand": true
          }
        }
      ]
    },
    {
      "type": "Split",
