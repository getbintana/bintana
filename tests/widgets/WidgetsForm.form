    "Height": 480,
    "Arrangement": "Vertical"
  },
  "actions": [
    {
      "name": "ActTest",
      "text": "Test command",
      "icon": "list-add-symbolic",
      "shortcut": "<Control><Shift>t"
    },
    {
      "name": "ActOff",
      "text": "Off to start",
      "enabled": false
    }
  ],
  "menus": [
    {
      "name": "MnuTest",
      "text": "_Test",
