          "name": "MnuOne",
          "text": "One",
          "shortcut": "<Control>1"
        },
        {
          "separator": true
        },
        {
          "name": "MnuMany",
          "text": "Many",
          "dynamic": true
        },
        {
          "separator": true
        },
        {
          "name": "MnuTick",
          "text": "Tick me",
          "check": true,
          "shortcut": "<Control>2"
        },
        {
          "name": "MnuPick",
          "text": "Pick one",
          "dynamic": true,
          "radio": true
        }
      ]
    }
  ],
  "children": [
