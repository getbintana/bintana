# A catalogue for a locale no desktop is ever set to.
#
# That is the point: the suite loads WidgetsForm.form before any test runs, so a
# catalogue named after a real language would translate the main form on whoever's
# machine is set to it and break the serialiser test -- on that machine only,
# which is the worst kind of flake. Every test here turns "zz" on by hand.
msgid ""
msgstr ""
"Project-Id-Version: widgets\n"
"Language: zz\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

msgid "Name:"
msgstr "NOMBRE:"

msgid "the customer's name"
msgstr "el nombre del cliente"

# A msgid that is also a valid CSS class name, so a Style wearing it would be
# rewritten if anything looked prose up by the value instead of by the property.
msgid "heading"
msgstr "TITULAR"

# Reordered on purpose: a translator has to be able to move the holes, which is
# what positional {0} is for and what a bare %s could never do.
msgid "{0} files, {1} unsaved"
msgstr "{1} sin guardar de {0}"

msgid "type here"
msgstr "escriba aqui"

msgid "Retail"
msgstr "Minorista"

msgid "Wholesale"
msgstr "Mayorista"

# The same word twice, told apart by its context and not by a key.
msgctxt "verb"
msgid "Open"
msgstr "Abrir"

msgid "Open"
msgstr "Abierto"

msgid "{0} file"
msgid_plural "{0} files"
msgstr[0] "{0} archivo"
msgstr[1] "{0} archivoj"
msgstr[2] "{0} archivojn"

# Fuzzy means a tool guessed it and nobody confirmed: showing it is worse than
# showing the original.
#, fuzzy
msgid "Guessed"
msgstr "NO USAR"

