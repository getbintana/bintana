{
  "format": "bintana-form/1",
  "class": "TabOrderForm",
  "properties": {
    "Height": 396,
    "Icon": "view-sort-ascending-symbolic",
    "Text": "Tab order",
    "Width": 380,
    "Arrangement": "Vertical",
    "Spacing": 8,
    "Margin": 12
  },
  "children": [
    {
      "type": "Label",
      "name": "LblWhich",
      "properties": {
        "Ellipsize": true,
        "HAlign": "Fill",
        "Text": "Tab order"
      }
    },
    {
      "type": "ListBox",
      "name": "LstOrder",
      "properties": {
        "HAlign": "Fill",
        "VExpand": true,
        "Style": "frame"
      }
    },
    {
      "type": "Panel",
      "name": "Bar",
      "properties": {
        "Arrangement": "Horizontal",
        "Spacing": 8,
        "HAlign": "Fill"
      },
      "children": [
        {
          "type": "Button",
          "name": "BtnUp",
          "properties": {
            "Text": "Move up"
          }
        },
        {
          "type": "Button",
          "name": "BtnDown",
          "properties": {
            "Text": "Move down"
          }
        },
        {
          "type": "Panel",
          "name": "Spacer",
          "properties": {
            "HExpand": true
          }
        },
        {
          "type": "Button",
          "name": "BtnCancel",
          "properties": {
            "Text": "Cancel",
            "Cancel": true
          }
        },
        {
          "type": "Button",
          "name": "BtnOk",
          "properties": {
            "Text": "OK",
            "Default": true,
            "Style": "suggested-action"
          }
        }
      ]
    }
  ]
}
