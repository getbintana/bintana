{
  "format": "bintana-form/1",
  "class": "LogForm",
  "properties": {
    "Arrangement": "Vertical",
    "Height": 620,
    "Icon": "document-open-recent-symbolic",
    "Text": "History",
    "Width": 980
  },
  "children": [
    {
      "type": "Split",
      "name": "Outer",
      "properties": {
        "Arrangement": "Vertical",
        "Expand": true,
        "HAlign": "Fill",
        "HExpand": true,
        "Margin": 8,
        "Position": 220,
        "VAlign": "Fill",
        "VExpand": true
      },
      "children": [
        {
          "type": "TableView",
          "name": "Commits",
          "properties": {
            "Expand": true,
            "HAlign": "Fill",
            "HExpand": true,
            "Tooltip": "The last commits, newest first",
            "VAlign": "Fill",
            "VExpand": true
          }
        },
        {
          "type": "Split",
          "name": "Below",
          "properties": {
            "Arrangement": "Horizontal",
            "Expand": true,
            "HAlign": "Fill",
            "HExpand": true,
            "Position": 260,
            "VAlign": "Fill",
            "VExpand": true
          },
          "children": [
            {
              "type": "TableView",
              "name": "Touched",
              "properties": {
                "Expand": true,
                "HAlign": "Fill",
                "HExpand": true,
                "MinWidth": 180,
                "Tooltip": "What that commit touched. Choosing one shows what it did to it",
                "VAlign": "Fill",
                "VExpand": true
              }
            },
            {
              "type": "Switcher",
              "name": "How",
              "properties": {
                "Expand": true,
                "HAlign": "Fill",
                "HExpand": true,
                "Tabs": [
                  "Side by side",
                  "Unified"
                ],
                "VAlign": "Fill",
                "VExpand": true
              },
              "children": [
                {
                  "type": "Split",
                  "name": "Pair",
                  "properties": {
                    "Arrangement": "Horizontal",
                    "Expand": true,
                    "HAlign": "Fill",
                    "HExpand": true,
                    "Position": 330,
                    "VAlign": "Fill",
                    "VExpand": true
                  },
                  "children": [
                    {
                      "type": "SourceEditor",
                      "name": "Before",
                      "properties": {
                        "Expand": true,
                        "Font": "Monospace 10",
                        "HAlign": "Fill",
                        "HExpand": true,
                        "MinWidth": 120,
                        "ReadOnly": true,
                        "VAlign": "Fill",
                        "VExpand": true,
                        "Wrap": false
                      }
                    },
                    {
                      "type": "SourceEditor",
                      "name": "After",
                      "properties": {
                        "Expand": true,
                        "Font": "Monospace 10",
                        "HAlign": "Fill",
                        "HExpand": true,
                        "MinWidth": 120,
                        "ReadOnly": true,
                        "VAlign": "Fill",
                        "VExpand": true,
                        "Wrap": false
                      }
                    }
                  ]
                },
                {
                  "type": "SourceEditor",
                  "name": "Unified",
                  "properties": {
                    "Expand": true,
                    "Font": "Monospace 10",
                    "HAlign": "Fill",
                    "HExpand": true,
                    "Language": "diff",
                    "ReadOnly": true,
                    "VAlign": "Fill",
                    "VExpand": true,
                    "Wrap": false
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Panel",
      "name": "Foot",
      "properties": {
        "Arrangement": "Horizontal",
        "HAlign": "Fill",
        "Margin": 8,
        "Spacing": 8
      },
      "children": [
        {
          "type": "Label",
          "name": "LblWhat",
          "properties": {
            "Ellipsize": true,
            "HAlign": "Fill",
            "HExpand": true,
            "Height": 22,
            "Style": "dim-label"
          }
        },
        {
          "type": "Button",
          "name": "BtnClose",
          "properties": {
            "Cancel": true,
            "Default": true,
            "Height": 32,
            "Text": "Close",
            "Width": 96
          }
        }
      ]
    }
  ]
}
