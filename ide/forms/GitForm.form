{
  "format": "bintana-form/1",
  "class": "GitForm",
  "properties": {
    "Arrangement": "Vertical",
    "Height": 620,
    "Icon": "document-edit-symbolic",
    "Text": "Changes",
    "Width": 980
  },
  "children": [
    {
      "type": "Split",
      "name": "Top",
      "properties": {
        "Arrangement": "Horizontal",
        "Expand": true,
        "HAlign": "Fill",
        "HExpand": true,
        "Margin": 8,
        "Position": 260,
        "VAlign": "Fill",
        "VExpand": true
      },
      "children": [
        {
          "type": "Panel",
          "name": "LeftBox",
          "properties": {
            "Arrangement": "Vertical",
            "HAlign": "Fill",
            "MinWidth": 180,
            "Spacing": 2,
            "VAlign": "Fill"
          },
          "children": [
            {
              "type": "Switcher",
              "name": "Which",
              "properties": {
                "Expand": true,
                "HExpand": true,
                "Tabs": [
                  "Not staged",
                  "Staged"
                ],
                "VExpand": true
              },
              "children": [
                {
                  "type": "TableView",
                  "name": "Unstaged",
                  "properties": {
                    "Expand": true,
                    "HExpand": true,
                    "VExpand": true
                  }
                },
                {
                  "type": "TableView",
                  "name": "Staged",
                  "properties": {
                    "Expand": true,
                    "HExpand": true,
                    "VExpand": true
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "Panel",
          "name": "RightBox",
          "properties": {
            "Arrangement": "Vertical",
            "HAlign": "Fill",
            "MinWidth": 320,
            "Spacing": 2,
            "VAlign": "Fill"
          },
          "children": [
            {
              "type": "Switcher",
              "name": "How",
              "properties": {
                "Expand": true,
                "HExpand": true,
                "Tabs": [
                  "Side by side",
                  "Unified"
                ],
                "VExpand": true
              },
              "children": [
                {
                  "type": "Split",
                  "name": "Pair",
                  "properties": {
                    "Arrangement": "Horizontal",
                    "Expand": true,
                    "HAlign": "Fill",
                    "HExpand": true,
                    "Position": 340,
                    "VAlign": "Fill",
                    "VExpand": true
                  },
                  "children": [
                    {
                      "type": "SourceEditor",
                      "name": "Before",
                      "properties": {
                        "Expand": true,
                        "Font": "Monospace 10",
                        "HAlign": "Fill",
                        "HExpand": true,
                        "MinWidth": 120,
                        "ReadOnly": true,
                        "VAlign": "Fill",
                        "VExpand": true,
                        "Wrap": false
                      }
                    },
                    {
                      "type": "SourceEditor",
                      "name": "After",
                      "properties": {
                        "Expand": true,
                        "Font": "Monospace 10",
                        "HAlign": "Fill",
                        "HExpand": true,
                        "MinWidth": 120,
                        "ReadOnly": true,
                        "VAlign": "Fill",
                        "VExpand": true,
                        "Wrap": false
                      }
                    }
                  ]
                },
                {
                  "type": "SourceEditor",
                  "name": "Unified",
                  "properties": {
                    "Expand": true,
                    "Font": "Monospace 10",
                    "HAlign": "Fill",
                    "HExpand": true,
                    "Language": "diff",
                    "ReadOnly": true,
                    "VAlign": "Fill",
                    "VExpand": true,
                    "Wrap": false
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Label",
      "name": "LblMessage",
      "properties": {
        "HAlign": "Start",
        "Margin": 8,
        "Style": "caption-heading",
        "Text": "Commit message"
      }
    },
    {
      "type": "TextEditor",
      "name": "Message",
      "properties": {
        "HAlign": "Fill",
        "Height": 76,
        "Margin": 8
      }
    },
    {
      "type": "Panel",
      "name": "Buttons",
      "properties": {
        "Arrangement": "Horizontal",
        "HAlign": "Fill",
        "Margin": 8,
        "Spacing": 8
      },
      "children": [
        {
          "type": "Button",
          "name": "BtnStage",
          "properties": {
            "Height": 32,
            "Text": "Stage",
            "Tooltip": "Put the chosen files in the next commit",
            "Width": 96
          }
        },
        {
          "type": "Button",
          "name": "BtnUnstage",
          "properties": {
            "Height": 32,
            "Text": "Unstage",
            "Tooltip": "Take the chosen files back out of the next commit",
            "Width": 96
          }
        },
        {
          "type": "Button",
          "name": "BtnDiscard",
          "properties": {
            "Height": 32,
            "Style": "destructive-action",
            "Text": "Discard",
            "Tooltip": "Throw away what was written in the chosen files. There is no undo",
            "Width": 96
          }
        },
        {
          "type": "Label",
          "name": "LblGitStatus",
          "properties": {
            "Ellipsize": true,
            "HAlign": "Fill",
            "HExpand": true,
            "Style": "dim-label"
          }
        },
        {
          "type": "Button",
          "name": "BtnClose",
          "properties": {
            "Cancel": true,
            "Height": 32,
            "Text": "Close",
            "Width": 96
          }
        },
        {
          "type": "Button",
          "name": "BtnCommit",
          "properties": {
            "Default": true,
            "Height": 32,
            "Style": "suggested-action",
            "Text": "Commit",
            "Tooltip": "Commit what is staged, with the message above",
            "Width": 96
          }
        }
      ]
    }
  ]
}
