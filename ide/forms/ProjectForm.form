{
  "format": "bintana-form/1",
  "class": "ProjectForm",
  "properties": {
    "Text": "Project",
    "Width": 560,
    "Height": 698
  },
  "children": [
    {
      "type": "Label",
      "name": "LblPrName",
      "properties": {
        "Height": 24,
        "Text": "Name:",
        "Width": 110,
        "X": 16,
        "Y": 22
      }
    },
    {
      "type": "TextBox",
      "name": "TxtPrName",
      "properties": {
        "HAlign": "Fill",
        "Height": 34,
        "Width": 410,
        "X": 134,
        "Y": 16
      }
    },
    {
      "type": "Label",
      "name": "LblPrVersion",
      "properties": {
        "Height": 24,
        "Text": "Version:",
        "Width": 110,
        "X": 16,
        "Y": 68
      }
    },
    {
      "type": "TextBox",
      "name": "TxtPrVersion",
      "properties": {
        "HAlign": "Fill",
        "Height": 34,
        "Placeholder": "0.1.0",
        "Width": 410,
        "X": 134,
        "Y": 62
      }
    },
    {
      "type": "Label",
      "name": "LblPrId",
      "properties": {
        "Height": 24,
        "Text": "Application id:",
        "Width": 110,
        "X": 16,
        "Y": 114
      }
    },
    {
      "type": "TextBox",
      "name": "TxtPrId",
      "properties": {
        "HAlign": "Fill",
        "Height": 34,
        "Placeholder": "io.github.you.MyApp",
        "Tooltip": "Reverse-DNS identity: the window's class, the metainfo's <id> and the Flatpak app id. Optional -- a project without one runs, and cannot be packaged.",
        "Width": 410,
        "X": 134,
        "Y": 108
      }
    },
    {
      "type": "Label",
      "name": "LblPrStartup",
      "properties": {
        "Height": 24,
        "Text": "Starts at:",
        "Width": 110,
        "X": 16,
        "Y": 160
      }
    },
    {
      "type": "ComboBox",
      "name": "CmbPrKind",
      "properties": {
        "Height": 34,
        "Index": 0,
        "Items": [
          "a form",
          "a function"
        ],
        "Text": "a form",
        "Tooltip": "A project opens a startup form, or calls a main function and never draws at all.",
        "Width": 126,
        "X": 134,
        "Y": 154
      }
    },
    {
      "type": "ComboBox",
      "name": "CmbPrStartup",
      "properties": {
        "HAlign": "Fill",
        "Height": 34,
        "Width": 276,
        "X": 268,
        "Y": 154
      }
    },
    {
      "type": "TextBox",
      "name": "TxtPrMain",
      "properties": {
        "Height": 34,
        "Tooltip": "The function the runtime calls; the IDE cannot list functions, so type it",
        "Visible": false,
        "Width": 276,
        "X": 268,
        "Y": 154
      }
    },
    {
      "type": "Label",
      "name": "LblPrDesc",
      "properties": {
        "Height": 24,
        "Text": "Description:",
        "Width": 110,
        "X": 16,
        "Y": 206
      }
    },
    {
      "type": "TextBox",
      "name": "TxtPrDesc",
      "properties": {
        "HAlign": "Fill",
        "Height": 34,
        "Width": 410,
        "X": 134,
        "Y": 200
      }
    },
    {
      "type": "Label",
      "name": "LblPrUses",
      "properties": {
        "Height": 24,
        "Text": "Libraries:",
        "Width": 200,
        "X": 16,
        "Y": 250
      }
    },
    {
      "type": "RowList",
      "name": "LstPrUses",
      "properties": {
        "HAlign": "Fill",
        "Height": 110,
        "Style": "frame",
        "Width": 528,
        "X": 16,
        "Y": 278
      }
    },
    {
      "type": "Label",
      "name": "LblPrUsesHint",
      "properties": {
        "HAlign": "Fill",
        "Height": 36,
        "Style": "dim-label",
        "Width": 528,
        "Wrap": true,
        "X": 16,
        "Y": 396
      }
    },
    {
      "type": "Label",
      "name": "LblPrOrder",
      "properties": {
        "Height": 24,
        "Text": "Load order:",
        "Width": 200,
        "X": 16,
        "Y": 442
      }
    },
    {
      "type": "ListBox",
      "name": "LstPrSources",
      "properties": {
        "HAlign": "Fill",
        "Height": 120,
        "Style": "frame",
        "VAlign": "Fill",
        "Width": 424,
        "X": 16,
        "Y": 470
      }
    },
    {
      "type": "Button",
      "name": "BtnPrUp",
      "properties": {
        "HAlign": "End",
        "Height": 32,
        "Text": "Up",
        "Width": 92,
        "X": 452,
        "Y": 470
      }
    },
    {
      "type": "Button",
      "name": "BtnPrDown",
      "properties": {
        "HAlign": "End",
        "Height": 32,
        "Text": "Down",
        "Width": 92,
        "X": 452,
        "Y": 508
      }
    },
    {
      "type": "Button",
      "name": "BtnPrDecide",
      "properties": {
        "HAlign": "End",
        "Height": 32,
        "Text": "Decide",
        "Tooltip": "Write the order this project already loads in, so it can be changed",
        "Width": 92,
        "X": 452,
        "Y": 556
      }
    },
    {
      "type": "Label",
      "name": "LblPrHint",
      "properties": {
        "HAlign": "Fill",
        "Height": 40,
        "Style": "dim-label",
        "VAlign": "End",
        "Width": 528,
        "Wrap": true,
        "X": 16,
        "Y": 602
      }
    },
    {
      "type": "Button",
      "name": "BtnPrCancel",
      "properties": {
        "Cancel": true,
        "HAlign": "End",
        "Height": 32,
        "Text": "Cancel",
        "VAlign": "End",
        "Width": 90,
        "X": 354,
        "Y": 650
      }
    },
    {
      "type": "Button",
      "name": "BtnPrOk",
      "properties": {
        "Default": true,
        "HAlign": "End",
        "Height": 32,
        "Style": "suggested-action",
        "Text": "OK",
        "VAlign": "End",
        "Width": 90,
        "X": 454,
        "Y": 650
      }
    }
  ]
}
