{
  "format": "bintana-form/1",
  "class": "AppForm",
  "properties": {
    "Text": "Install as user application",
    "Width": 552,
    "Height": 304
  },
  "children": [
    {
      "type": "Label",
      "name": "LblAppName",
      "properties": {
        "X": 12,
        "Y": 18,
        "Width": 110,
        "Height": 24,
        "Text": "Name:"
      }
    },
    {
      "type": "TextBox",
      "name": "TxtAppName",
      "properties": {
        "X": 130,
        "Y": 12,
        "Width": 410,
        "Height": 34,
        "HAlign": "Fill"
      }
    },
    {
      "type": "Label",
      "name": "LblAppComment",
      "properties": {
        "X": 12,
        "Y": 64,
        "Width": 110,
        "Height": 24,
        "Text": "Comment:"
      }
    },
    {
      "type": "TextBox",
      "name": "TxtAppComment",
      "properties": {
        "X": 130,
        "Y": 58,
        "Width": 410,
        "Height": 34,
        "HAlign": "Fill",
        "Tooltip": "What the menu shows about it; empty is no tooltip at all"
      }
    },
    {
      "type": "Label",
      "name": "LblAppIcon",
      "properties": {
        "X": 12,
        "Y": 110,
        "Width": 110,
        "Height": 24,
        "Text": "Icon:"
      }
    },
    {
      "type": "TextBox",
      "name": "TxtAppIcon",
      "properties": {
        "X": 130,
        "Y": 104,
        "Width": 324,
        "Height": 34,
        "HAlign": "Fill",
        "Tooltip": "A name from the desktop's theme, or a path to an image of the project's"
      }
    },
    {
      "type": "Button",
      "name": "BtnAppIcon",
      "properties": {
        "X": 462,
        "Y": 104,
        "Width": 78,
        "Height": 34,
        "Text": "Choose…",
        "HAlign": "End"
      }
    },
    {
      "type": "Label",
      "name": "LblAppWhere",
      "properties": {
        "X": 12,
        "Y": 152,
        "Width": 528,
        "Height": 38,
        "Text": "",
        "Wrap": true,
        "Style": "dim-label",
        "HAlign": "Fill"
      }
    },
    {
      "type": "Label",
      "name": "LblAppHint",
      "properties": {
        "X": 12,
        "Y": 196,
        "Width": 528,
        "Height": 40,
        "Text": "The application is offered in this user's menu. Nothing is installed system-wide and no password is asked.",
        "Wrap": true,
        "Style": "dim-label",
        "HAlign": "Fill"
      }
    },
    {
      "type": "Button",
      "name": "BtnAppUninstall",
      "properties": {
        "X": 12,
        "Y": 260,
        "Width": 110,
        "Height": 32,
        "Text": "Uninstall",
        "HAlign": "Start",
        "VAlign": "End"
      }
    },
    {
      "type": "Button",
      "name": "BtnAppCancel",
      "properties": {
        "X": 350,
        "Y": 260,
        "Width": 90,
        "Height": 32,
        "Text": "Cancel",
        "HAlign": "End",
        "VAlign": "End",
        "Cancel": true
      }
    },
    {
      "type": "Button",
      "name": "BtnAppInstall",
      "properties": {
        "X": 450,
        "Y": 260,
        "Width": 90,
        "Height": 32,
        "Text": "Install",
        "Style": "suggested-action",
        "HAlign": "End",
        "VAlign": "End",
        "Default": true
      }
    }
  ]
}
