{
  "format": "bintana-form/1",
  "class": "AppsForm",
  "properties": {
    "Text": "Installed applications",
    "Width": 560,
    "Height": 420
  },
  "children": [
    {
      "type": "Label",
      "name": "LblAppsHint",
      "properties": {
        "X": 12,
        "Y": 10,
        "Width": 536,
        "Height": 38,
        "Text": "Applications installed for this user from the IDE. Removing one takes it out of the menu; the project and its files are not touched.",
        "Wrap": true,
        "Style": "dim-label",
        "HAlign": "Fill"
      }
    },
    {
      "type": "ListBox",
      "name": "LstApps",
      "properties": {
        "X": 12,
        "Y": 52,
        "Width": 536,
        "Height": 200,
        "HAlign": "Fill"
      }
    },
    {
      "type": "Label",
      "name": "LblAppsNone",
      "properties": {
        "X": 12,
        "Y": 52,
        "Width": 536,
        "Height": 24,
        "Text": "No application installed from the IDE.",
        "Style": "dim-label",
        "HAlign": "Fill"
      }
    },
    {
      "type": "Label",
      "name": "LblAppsWhere",
      "properties": {
        "X": 12,
        "Y": 258,
        "Width": 536,
        "Height": 34,
        "Text": "",
        "Wrap": true,
        "Style": "dim-label",
        "HAlign": "Fill"
      }
    },
    {
      "type": "Label",
      "name": "LblAppsFiles",
      "properties": {
        "X": 12,
        "Y": 294,
        "Width": 536,
        "Height": 76,
        "Text": "",
        "Wrap": true,
        "Style": "dim-label",
        "HAlign": "Fill"
      }
    },
    {
      "type": "Button",
      "name": "BtnAppsRemove",
      "properties": {
        "X": 12,
        "Y": 376,
        "Width": 110,
        "Height": 32,
        "Text": "Uninstall…",
        "HAlign": "Start",
        "VAlign": "End"
      }
    },
    {
      "type": "Button",
      "name": "BtnAppsClose",
      "properties": {
        "X": 458,
        "Y": 376,
        "Width": 90,
        "Height": 32,
        "Text": "Close",
        "HAlign": "End",
        "VAlign": "End",
        "Cancel": true,
        "Default": true
      }
    }
  ]
}
