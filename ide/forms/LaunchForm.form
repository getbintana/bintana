{
  "format": "bintana-form/1",
  "class": "LaunchForm",
  "properties": {
    "Height": 512,
    "Icon": "system-run-symbolic",
    "Text": "Run configurations",
    "Width": 652
  },
  "children": [
    {
      "type": "Label",
      "name": "LblLcList",
      "properties": {
        "Height": 20,
        "Style": "dim-label",
        "Text": "Configurations:",
        "Width": 180,
        "X": 12,
        "Y": 12
      }
    },
    {
      "type": "ListBox",
      "name": "LstLcNames",
      "properties": {
        "Height": 376,
        "MinHeight": 120,
        "MinWidth": 150,
        "Style": "frame",
        "VAlign": "Fill",
        "Width": 190,
        "X": 12,
        "Y": 34
      }
    },
    {
      "type": "Button",
      "name": "BtnLcAdd",
      "properties": {
        "Height": 30,
        "Text": "Add",
        "Tooltip": "A new configuration, with the defaults below copied into it",
        "VAlign": "End",
        "Width": 92,
        "X": 12,
        "Y": 418
      }
    },
    {
      "type": "Button",
      "name": "BtnLcRemove",
      "properties": {
        "Height": 30,
        "Text": "Remove",
        "VAlign": "End",
        "Width": 92,
        "X": 110,
        "Y": 418
      }
    },
    {
      "type": "Label",
      "name": "LblLcName",
      "properties": {
        "Height": 20,
        "Text": "Name:",
        "Width": 110,
        "X": 222,
        "Y": 34
      }
    },
    {
      "type": "TextBox",
      "name": "TxtLcName",
      "properties": {
        "HAlign": "Fill",
        "Height": 32,
        "Width": 418,
        "X": 222,
        "Y": 56
      }
    },
    {
      "type": "Label",
      "name": "LblLcArgs",
      "properties": {
        "Height": 20,
        "Text": "Arguments, one per line:",
        "Width": 260,
        "X": 222,
        "Y": 96
      }
    },
    {
      "type": "TextEditor",
      "name": "TxtLcArgs",
      "properties": {
        "HAlign": "Fill",
        "Height": 96,
        "Style": "frame",
        "Width": 418,
        "X": 222,
        "Y": 118
      }
    },
    {
      "type": "Label",
      "name": "LblLcDir",
      "properties": {
        "Height": 20,
        "Text": "Directory, empty for the project’s own:",
        "Width": 300,
        "X": 222,
        "Y": 224
      }
    },
    {
      "type": "TextBox",
      "name": "TxtLcDir",
      "properties": {
        "HAlign": "Fill",
        "Height": 32,
        "Width": 418,
        "X": 222,
        "Y": 246
      }
    },
    {
      "type": "Label",
      "name": "LblLcEnv",
      "properties": {
        "Height": 20,
        "Text": "Environment, NAME=value one per line:",
        "Width": 300,
        "X": 222,
        "Y": 286
      }
    },
    {
      "type": "TextEditor",
      "name": "TxtLcEnv",
      "properties": {
        "HAlign": "Fill",
        "Height": 90,
        "Style": "frame",
        "Width": 418,
        "X": 222,
        "Y": 308
      }
    },
    {
      "type": "CheckButton",
      "name": "ChkLcStrict",
      "properties": {
        "Height": 26,
        "Text": "Strict checks",
        "Tooltip": "A control refuses a property its class does not have",
        "Width": 190,
        "X": 222,
        "Y": 408
      }
    },
    {
      "type": "CheckButton",
      "name": "ChkLcThrow",
      "properties": {
        "Height": 26,
        "Text": "Stop where something is thrown",
        "Width": 260,
        "X": 222,
        "Y": 436
      }
    },
    {
      "type": "Label",
      "name": "LblLcDefaults",
      "properties": {
        "Height": 20,
        "Style": "dim-label",
        "Text": "New configurations start with these two as they are now.",
        "Width": 220,
        "X": 222,
        "Y": 464
      }
    },
    {
      "type": "Button",
      "name": "BtnLcCancel",
      "properties": {
        "Cancel": true,
        "HAlign": "End",
        "Height": 32,
        "Text": "Cancel",
        "VAlign": "End",
        "Width": 92,
        "X": 448,
        "Y": 468
      }
    },
    {
      "type": "Button",
      "name": "BtnLcOk",
      "properties": {
        "Default": true,
        "HAlign": "End",
        "Height": 32,
        "Style": "suggested-action",
        "Text": "Save",
        "VAlign": "End",
        "Width": 92,
        "X": 548,
        "Y": 468
      }
    }
  ]
}
