{
  "format": "bintana-form/1",
  "class": "HelpForm",
  "properties": {
    "Text": "Reference",
    "Width": 980,
    "Height": 720,
    "Arrangement": "Vertical",
    "HideOnClose": true
  },
  "children": [
    {
      "type": "Split",
      "name": "Halves",
      "properties": {
        "Expand": true,
        "Grows": "End",
        "HExpand": true,
        "Height": 720,
        "Position": 230,
        "VExpand": true,
        "Width": 980
      },
      "children": [
        {
          "type": "TreeView",
          "name": "Pages",
          "properties": {
            "HAlign": "Fill",
            "MinWidth": 140,
            "VAlign": "Fill"
          }
        },
        {
          "type": "Panel",
          "name": "Right",
          "properties": {
            "Arrangement": "Vertical"
          },
          "children": [
            {
              "type": "Panel",
              "name": "Bar",
              "properties": {
                "Arrangement": "Horizontal",
                "Height": 36,
                "Spacing": 6,
                "Style": "toolbar"
              },
              "children": [
                {
                  "type": "Button",
                  "name": "BtnBack",
                  "properties": {
                    "Enabled": false,
                    "Height": 28,
                    "Style": "flat",
                    "Text": "Back",
                    "Width": 80
                  }
                },
                {
                  "type": "Label",
                  "name": "LblWhere",
                  "properties": {
                    "Ellipsize": true,
                    "Expand": true,
                    "HExpand": true,
                    "Style": "dim-label",
                    "VExpand": true
                  }
                },
                {
                  "type": "TextBox",
                  "name": "TxtFind",
                  "properties": {
                    "Height": 28,
                    "Icon": "edit-find-symbolic",
                    "Placeholder": "Find",
                    "Width": 200
                  }
                }
              ]
            },
            {
              "type": "Markdown",
              "name": "Doc",
              "properties": {
                "Expand": true,
                "HAlign": "Fill",
                "HExpand": true,
                "Margins": 28,
                "MaxWidth": 760,
                "VAlign": "Fill",
                "VExpand": true
              }
            }
          ]
        }
      ]
    }
  ]
}
