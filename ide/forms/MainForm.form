                              "type": "Button",
                              "name": "BtnTakeDisk",
                              "properties": {
                                "Height": 28,
                                "Style": "suggested-action",
                                "Text": "Reload",
                                "Width": 90
                              }
                            },
                            {
                              "type": "Button",
                              "name": "BtnReloadHide",
                              "properties": {
                                "Height": 28,
                                "Icon": "window-close-symbolic",
                                "Style": "flat",
                                "Tooltip": "Keep what is open",
                                "Width": 30
                              }
                            }
                          ]
                        },
                        {
                          "type": "Notebook",
                          "name": "Tabs",
                          "properties": {
                            "Expand": true,
                            "HExpand": true,
                            "Margin": 2,
                            "VExpand": true
                          },
                          "children": [
                            {
                              "type": "Button",
                              "name": "TabActions",
                              "properties": {
                                "Height": 28,
                                "Menu": [
                                  {
                                    "name": "MnuTabClose",
                                    "text": "Close tab"
                                  },
                                  {
                                    "name": "MnuTabOthers",
                                    "text": "Close others"
                                  },
                                  {
                                    "name": "MnuTabAll",
                                    "text": "Close all"
                                  },
                                  {
                                    "separator": true
                                  },
                                  {
                                    "name": "MnuTabSaveAll",
                                    "text": "Save all"
                                  }
                                ],
                                "Style": "flat",
                                "Tooltip": "Tab actions",
                                "Width": 32
                              },
                              "strip": "End"
                            }
                          ]
                        },
                        {
                          "type": "Panel",
                          "name": "FindBar",
                          "properties": {
                            "Arrangement": "Vertical",
                            "HAlign": "Fill",
                            "Margin": 2,
                            "Spacing": 2,
                            "Style": "toolbar",
                            "Visible": false
                          },
                          "children": [
                            {
                              "type": "Panel",
                              "name": "FindRow",
                              "properties": {
                                "Arrangement": "Horizontal",
                                "HAlign": "Fill",
                                "Spacing": 4
                              },
                              "children": [
                                {
                                  "type": "TextBox",
                                  "name": "FindText",
                                  "properties": {
                                    "HAlign": "Fill",
                                    "HExpand": true,
                                    "Icon": "edit-find-symbolic",
                                    "Tooltip": "Text to find"
                                  }
                                },
                                {
                                  "type": "Label",
                                  "name": "LblFindCount",
                                  "properties": {
                                    "Alignment": "Right",
                                    "Style": "dim-label",
                                    "Width": 96
                                  }
                                },
                                {
                                  "type": "Button",
                                  "name": "BtnFindPrev",
                                  "properties": {
                                    "Icon": "pan-up-symbolic",
                                    "Style": "flat",
                                    "Tooltip": "Previous match (Shift+F3)"
                                  }
                                },
                                {
                                  "type": "Button",
                                  "name": "BtnFindNext",
                                  "properties": {
                                    "Icon": "pan-down-symbolic",
                                    "Style": "flat",
                                    "Tooltip": "Next match (F3)"
                                  }
                                },
                                {
                                  "type": "CheckButton",
                                  "name": "ChkFindCase",
                                  "properties": {
                                    "Text": "Aa",
                                    "Tooltip": "Match case"
                                  }
                                },
                                {
                                  "type": "CheckButton",
                                  "name": "ChkFindWord",
                                  "properties": {
                                    "Text": "Word",
                                    "Tooltip": "Whole word only"
                                  }
                                },
                                {
                                  "type": "CheckButton",
                                  "name": "ChkFindRegex",
                                  "properties": {
                                    "Text": ".*",
                                    "Tooltip": "Regular expression"
                                  }
                                },
                                {
                                  "type": "Button",
                                  "name": "BtnFindClose",
                                  "properties": {
                                    "Icon": "window-close-symbolic",
                                    "Style": "flat",
                                    "Tooltip": "Close the find bar (Escape)"
                                  }
                                }
                              ]
                            },
                            {
                              "type": "Panel",
                              "name": "ReplaceRow",
                              "properties": {
                                "Arrangement": "Horizontal",
                                "HAlign": "Fill",
                                "Spacing": 4,
                                "Visible": false
                              },
                              "children": [
                                {
                                  "type": "TextBox",
                                  "name": "ReplaceText",
                                  "properties": {
                                    "HAlign": "Fill",
                                    "HExpand": true,
                                    "Icon": "edit-find-replace-symbolic",
                                    "Tooltip": "Replace the matches with this"
                                  }
                                },
                                {
                                  "type": "Button",
                                  "name": "BtnReplace",
                                  "properties": {
                                    "Text": "Replace"
                                  }
                                },
                                {
                                  "type": "Button",
                                  "name": "BtnReplaceAll",
                                  "properties": {
                                    "Text": "All"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "Notebook",
                      "name": "ConsoleBox",
                      "properties": {
                        "Height": 173,
                        "Tabs": [
                          "Output",
                          "Debug",
                          "Problems"
                        ]
                      },
                      "children": [
                        {
                          "type": "TextEditor",
                          "name": "LogView",
                          "properties": {
                            "Border": "0 solid #ffffff",
                            "Expand": true,
                            "Font": "Monospace 10",
                            "HAlign": "Fill",
                            "HExpand": true,
                            "ReadOnly": true,
                            "VAlign": "Fill",
                            "VExpand": true,
                            "Wrap": false
                          }
                        },
                        {
                          "type": "Panel",
                          "name": "DebugPage",
                          "properties": {
                            "Arrangement": "Vertical",
                            "Expand": true,
                            "HAlign": "Fill",
                            "HExpand": true,
                            "Spacing": 2,
                            "VAlign": "Fill",
                            "VExpand": true
                          },
                          "children": [
                            {
                              "type": "Panel",
                              "name": "DebugBar",
                              "properties": {
                                "Arrangement": "Horizontal",
                                "HAlign": "Fill",
                                "Spacing": 2
                              },
                              "children": [
                                {
                                  "type": "Button",
                                  "name": "BtnDbgDebug",
                                  "properties": {
                                    "Action": "ActDebug",
                                    "Height": 30,
                                    "Icon": "media-playback-start-symbolic",
                                    "Style": "flat",
                                    "Tooltip": "Debug, or continue when stopped (Ctrl+F9)",
                                    "Width": 34
                                  }
                                },
                                {
                                  "type": "Button",
                                  "name": "BtnDbgPause",
                                  "properties": {
                                    "Action": "ActPause",
                                    "Height": 30,
                                    "Icon": "media-playback-pause-symbolic",
                                    "Style": "flat",
                                    "Tooltip": "Pause (Ctrl+F8)",
                                    "Width": 34
                                  }
                                },
                                {
                                  "type": "Button",
                                  "name": "BtnDbgInto",
                                  "properties": {
                                    "Action": "ActStepInto",
                                    "Height": 30,
                                    "Icon": "go-down-symbolic",
                                    "Style": "flat",
                                    "Tooltip": "Step into (F8)",
                                    "Width": 34
                                  }
                                },
                                {
                                  "type": "Button",
                                  "name": "BtnDbgOver",
                                  "properties": {
                                    "Action": "ActStepOver",
                                    "Height": 30,
                                    "Icon": "go-next-symbolic",
                                    "Style": "flat",
                                    "Tooltip": "Step over (Shift+F8)",
                                    "Width": 34
                                  }
                                },
                                {
                                  "type": "Button",
                                  "name": "BtnDbgOut",
                                  "properties": {
                                    "Action": "ActStepOut",
                                    "Height": 30,
                                    "Icon": "go-up-symbolic",
                                    "Style": "flat",
                                    "Tooltip": "Step out (Ctrl+Shift+F8)",
                                    "Width": 34
                                  }
                                },
                                {
                                  "type": "Button",
                                  "name": "BtnDbgRunTo",
                                  "properties": {
                                    "Action": "ActRunTo",
                                    "Height": 30,
                                    "Icon": "media-seek-forward-symbolic",
                                    "Style": "flat",
                                    "Tooltip": "Run to cursor (Ctrl+F10)",
                                    "Width": 34
                                  }
                                },
                                {
                                  "type": "Button",
                                  "name": "BtnDbgStop",
                                  "properties": {
                                    "Action": "ActStop",
                                    "Height": 30,
                                    "Icon": "media-playback-stop-symbolic",
                                    "Style": "flat",
                                    "Tooltip": "Stop (Shift+F9)",
                                    "Width": 34
                                  }
                                }
                              ]
                            },
                            {
                              "type": "Split",
                              "name": "DebugBox",
                              "properties": {
                                "Arrangement": "Horizontal",
                                "Expand": true,
                                "HExpand": true,
                                "Position": 320,
                                "VExpand": true
                              },
                              "children": [
                                {
                                  "type": "Panel",
                                  "name": "StackBox",
                                  "properties": {
                                    "Arrangement": "Vertical",
                                    "Spacing": 2
                                  },
                                  "children": [
                                    {
                                      "type": "Label",
                                      "name": "LblStack",
                                      "properties": {
                                        "HAlign": "Start",
                                        "Margin": 4,
                                        "Style": "caption-heading",
                                        "Text": "Call stack"
                                      }
                                    },
                                    {
                                      "type": "RowList",
                                      "name": "StackList",
                                      "properties": {
                                        "Expand": true,
                                        "HExpand": true,
                                        "Tooltip": "The frames the program is stopped in. Choosing one shows its own values",
                                        "VExpand": true
                                      }
                                    }
                                  ]
                                },
                                {
                                  "type": "Panel",
                                  "name": "LocalBox",
                                  "properties": {
                                    "Arrangement": "Vertical",
                                    "Spacing": 2
                                  },
                                  "children": [
                                    {
                                      "type": "Label",
                                      "name": "LblLocals",
                                      "properties": {
                                        "HAlign": "Start",
                                        "Margin": 4,
                                        "Style": "caption-heading",
                                        "Text": "Values"
                                      }
                                    },
                                    {
                                      "type": "RowList",
                                      "name": "LocalList",
                                      "properties": {
                                        "Expand": true,
                                        "HExpand": true,
                                        "Tooltip": "The watches and then the chosen frame's own values. Arguments are in bold; double click one to change it",
                                        "VExpand": true
                                      }
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "type": "Panel",
                              "name": "ImmediateRow",
                              "properties": {
                                "Arrangement": "Horizontal",
                                "HAlign": "Fill",
                                "Spacing": 4
                              },
                              "children": [
                                {
                                  "type": "TextBox",
                                  "name": "TxtImmediate",
                                  "properties": {
                                    "HExpand": true,
                                    "Placeholder": "An expression, in the chosen frame",
                                    "Tooltip": "Evaluated where the program is stopped. Enter answers; Watch keeps it and re-asks at every stop"
                                  }
                                },
                                {
                                  "type": "Button",
                                  "name": "BtnWatch",
                                  "properties": {
                                    "Text": "Watch",
                                    "Tooltip": "Keep this expression and answer it again at every stop"
                                  }
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "TableView",
                          "name": "ProblemView",
                          "properties": {
                            "Expand": true,
                            "HAlign": "Fill",
                            "HExpand": true,
                            "RowLines": false,
                            "VAlign": "Fill",
                            "VExpand": true
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
