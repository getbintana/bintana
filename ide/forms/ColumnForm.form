{
  "format": "bintana-form/1",
  "class": "ColumnForm",
  "properties": {
    "Text": "Columns",
    "Width": 552,
    "Height": 414,
    "Icon": "x-office-spreadsheet-symbolic"
  },
  "children": [
    {
      "type": "Label",
      "name": "LblCols",
      "properties": {
        "Height": 24,
        "Text": "The columns, in order:",
        "Width": 300,
        "X": 12,
        "Y": 12
      }
    },
    {
      "type": "TableView",
      "name": "ColList",
      "properties": {
        "Columns": [
          {
            "Text": "Heading",
            "Width": 200
          },
          {
            "Text": "Width",
            "Width": 70,
            "Alignment": "Right"
          },
          {
            "Text": "Alignment",
            "Width": 100
          }
        ],
        "HAlign": "Fill",
        "Height": 180,
        "MinWidth": 260,
        "Style": "frame",
        "VAlign": "Fill",
        "Width": 420,
        "X": 12,
        "Y": 40
      }
    },
    {
      "type": "Button",
      "name": "BtnColAdd",
      "properties": {
        "HAlign": "End",
        "Height": 32,
        "Text": "Add",
        "Width": 96,
        "X": 444,
        "Y": 40
      }
    },
    {
      "type": "Button",
      "name": "BtnColDel",
      "properties": {
        "HAlign": "End",
        "Height": 32,
        "Text": "Delete",
        "Width": 96,
        "X": 444,
        "Y": 78
      }
    },
    {
      "type": "Button",
      "name": "BtnColUp",
      "properties": {
        "HAlign": "End",
        "Height": 32,
        "Text": "Up",
        "Width": 96,
        "X": 444,
        "Y": 124
      }
    },
    {
      "type": "Button",
      "name": "BtnColDown",
      "properties": {
        "HAlign": "End",
        "Height": 32,
        "Text": "Down",
        "Width": 96,
        "X": 444,
        "Y": 162
      }
    },
    {
      "type": "Label",
      "name": "LblColText",
      "properties": {
        "Height": 24,
        "Text": "Heading:",
        "Width": 90,
        "X": 12,
        "Y": 238
      }
    },
    {
      "type": "TextBox",
      "name": "TxtColText",
      "properties": {
        "ActivatesDefault": true,
        "HAlign": "Fill",
        "Height": 34,
        "Width": 300,
        "X": 108,
        "Y": 232
      }
    },
    {
      "type": "Label",
      "name": "LblColWidth",
      "properties": {
        "Height": 24,
        "Text": "Width:",
        "Width": 90,
        "X": 12,
        "Y": 280
      }
    },
    {
      "type": "SpinBox",
      "name": "SpnColWidth",
      "properties": {
        "Height": 34,
        "Max": 2000,
        "Min": 0,
        "Step": 10,
        "Width": 100,
        "X": 108,
        "Y": 274
      }
    },
    {
      "type": "Label",
      "name": "LblColAlign",
      "properties": {
        "Height": 24,
        "Text": "Alignment:",
        "Width": 80,
        "X": 258,
        "Y": 280
      }
    },
    {
      "type": "ComboBox",
      "name": "CmbColAlign",
      "properties": {
        "Height": 34,
        "Width": 100,
        "X": 345,
        "Y": 274
      }
    },
    {
      "type": "Label",
      "name": "LblColHint",
      "properties": {
        "HAlign": "Fill",
        "Height": 34,
        "Style": "dim-label",
        "Text": "A width of 0 lets the column size itself. Every column can be dragged whatever it says here.",
        "VAlign": "End",
        "Width": 528,
        "Wrap": true,
        "X": 12,
        "Y": 320
      }
    },
    {
      "type": "Button",
      "name": "BtnColCancel",
      "properties": {
        "Cancel": true,
        "HAlign": "End",
        "Height": 32,
        "Text": "Cancel",
        "VAlign": "End",
        "Width": 90,
        "X": 350,
        "Y": 370
      }
    },
    {
      "type": "Button",
      "name": "BtnColOk",
      "properties": {
        "Default": true,
        "HAlign": "End",
        "Height": 32,
        "Style": "suggested-action",
        "Text": "OK",
        "VAlign": "End",
        "Width": 90,
        "X": 450,
        "Y": 370
      }
    }
  ]
}
