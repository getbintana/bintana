{
  "format": "bintana-form/1",
  "class": "QuickForm",
  "properties": {
    "Height": 460,
    "Icon": "system-search-symbolic",
    "Text": "Go to file",
    "Width": 520
  },
  "children": [
    {
      "type": "TextBox",
      "name": "TxtFind",
      "properties": {
        "HAlign": "Fill",
        "Height": 34,
        "Icon": "edit-clear-symbolic",
        "Placeholder": "A file, or > for a command",
        "Tooltip": "Type part of a file's name, or > to run a command",
        "Width": 488,
        "X": 16,
        "Y": 16
      }
    },
    {
      "type": "RowList",
      "name": "List",
      "properties": {
        "HAlign": "Fill",
        "Height": 328,
        "MinHeight": 120,
        "MinWidth": 320,
        "Style": "frame",
        "VAlign": "Fill",
        "Width": 488,
        "X": 16,
        "Y": 58
      }
    },
    {
      "type": "Label",
      "name": "LblCount",
      "properties": {
        "Ellipsize": true,
        "HAlign": "Fill",
        "Height": 22,
        "Style": "dim-label",
        "VAlign": "End",
        "Width": 300,
        "X": 16,
        "Y": 394
      }
    },
    {
      "type": "Button",
      "name": "BtnCancel",
      "properties": {
        "Cancel": true,
        "HAlign": "End",
        "Height": 32,
        "Text": "Cancel",
        "VAlign": "End",
        "Width": 90,
        "X": 316,
        "Y": 412
      }
    },
    {
      "type": "Button",
      "name": "BtnOk",
      "properties": {
        "Default": true,
        "HAlign": "End",
        "Height": 32,
        "Style": "suggested-action",
        "Text": "Go",
        "VAlign": "End",
        "Width": 90,
        "X": 414,
        "Y": 412
      }
    }
  ]
}
