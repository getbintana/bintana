#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @BTA_RC_VERSION_COMMA@
 PRODUCTVERSION @BTA_RC_VERSION_COMMA@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @BTA_RC_FILETYPE@
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Bintana"
            VALUE "FileDescription", "@BTA_RC_DESCRIPTION@"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "@BTA_RC_INTERNAL@"
            VALUE "LegalCopyright", "Copyright (c) 2026 Matias De lellis"
            VALUE "OriginalFilename", "@BTA_RC_ORIGINAL@"
            VALUE "ProductName", "Bintana"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
