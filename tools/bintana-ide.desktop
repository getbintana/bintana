# The IDE's menu entry.
#
# `Exec` is the bare name and not a path: the launcher is installed in bindir,
# and a path baked in here would be the configure-time prefix rather than
# wherever the install actually landed.
#
# `StartupWMClass` is what ties a window back to this file, and it is the IDE's
# application id -- the string `ide/project.json` declares, which the runtime
# hands to `GtkApplication` (Wayland's app id) and to the program name (X11's
# `WM_CLASS`).  It used to be `bintana-ide`, the name the launcher started the
# runtime under; the id is the same mechanism with the name the entry is
# installed as, so the window and the file agree on all three.
[Desktop Entry]
Type=Application
Version=1.0
Name=Bintana IDE
Name[es]=IDE de Bintana
GenericName=Form designer
GenericName[es]=Diseñador de formularios
Comment=Design forms and write the code behind them
Comment[es]=Diseñá formularios y escribí el código detrás de ellos
Exec=bintana-ide %f
Icon=bintana-ide
Terminal=false
Categories=Development;IDE;GUIDesigner;
Keywords=Bintana;RAD;forms;JavaScript;GTK;
StartupWMClass=io.github.getbintana.Ide
