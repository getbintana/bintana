#!/bin/sh
#
# The installed IDE, as one word.
#
# `bintana` takes a project directory and the IDE is a project like any other, so
# what a menu entry -- or a person at a shell -- needs is a name for the pair.
# That name is all this adds.
#
# **It resolves its own location instead of carrying a prefix.** The path baked
# in at configure time is wrong for every install that moves afterwards, and two
# ordinary ones do: `cmake --install --prefix <staging>` and a packager's
# DESTDIR. What stays true is the hop between bindir and the IDE's data
# directory -- @BTA_BIN_TO_IDE@ -- because both move together.
#
# **The window's class is not this script's business.** It used to be: the
# runtime set no GTK application id, so this started the runtime under a name of
# its own (`exec -a bintana-ide`) and `StartupWMClass` matched that. The IDE now
# declares an application id, the runtime hands it to `GtkApplication` and to the
# program name, and the desktop file names the same string -- so this is a plain
# `exec`, and nothing here decides what the window is called. It is `/bin/sh`
# for the same reason: `exec -a` was the only bashism it ever had.
set -u

here=$(dirname "$(readlink -f "$0")")

exec "$here/bintana" "$here/@BTA_BIN_TO_IDE@" "$@"
